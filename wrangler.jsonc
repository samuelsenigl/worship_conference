{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worship-conference",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "chvaly.sizej.eu",
      "custom_domain": true
    }
  ]
}